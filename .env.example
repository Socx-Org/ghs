# GHS local development environment (SEC-010, socx-platform's
# reference/security local-dev pattern -- apps/api/src/config.ts's
# readSecret() falls back to these exact env vars when CREDENTIALS_DIRECTORY
# is unset, i.e. everywhere except a real systemd-managed host).
#
# Copy to .env in the project root and fill in real local values, or just
# run `npm run dev` -- scripts/dev.sh does this for you on first run,
# generating real JWT_SECRET/MFA_ENCRYPTION_KEY values automatically.
#
# .env.example itself is safe to commit -- every value below is a
# placeholder, never a real secret (SEC-010.1). .env is gitignored.

NODE_ENV=development
PORT=3000

# Database -- apps/api/src/config.ts's loadDatabaseConfig() reads these
# individually, not a single DATABASE_URL.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ghs_dev
DB_USER={{YOUR_LOCAL_POSTGRES_ROLE}}
DB_PASSWORD={{GENERATE_LOCALLY_DO_NOT_COMMIT}}

# Auth -- generate real values locally with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse a value from this file, and never commit a real one.
# MFA_ENCRYPTION_KEY must be 32 raw bytes, hex-encoded (64 hex characters)
# -- it's an AES-256-GCM key, not a hash (see AuthConfig in config.ts).
JWT_SECRET={{GENERATE_LOCALLY_DO_NOT_COMMIT}}
MFA_ENCRYPTION_KEY={{GENERATE_LOCALLY_DO_NOT_COMMIT}}

# Email -- mailpit is config.ts's own local-dev default; only needed if
# you're running a local Mailpit instance (or Docker equivalent).
EMAIL_PROVIDER=mailpit
EMAIL_FROM_ADDRESS=noreply@ghs.local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
