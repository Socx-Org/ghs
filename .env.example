# GHS local development environment (SEC-010, socx-platform's
# reference/security local-dev pattern -- apps/api/src/config.ts's
# readSecret() falls back to these exact env vars when CREDENTIALS_DIRECTORY
# is unset, i.e. everywhere except a real systemd-managed host).
#
# Copy to .env in the project root and fill in real local values, or just
# run `npm run dev` -- scripts/dev.sh does this for you on first run,
# generating real JWT_SECRET/MFA_ENCRYPTION_KEY values automatically.
#
# .env.example itself is safe to commit -- every value below is a
# placeholder, never a real secret (SEC-010.1). .env is gitignored.

NODE_ENV=development
PORT=3000

# Database -- apps/api/src/config.ts's loadDatabaseConfig() reads these
# individually, not a single DATABASE_URL.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ghs_dev
DB_USER={{YOUR_LOCAL_POSTGRES_ROLE}}
DB_PASSWORD={{GENERATE_LOCALLY_DO_NOT_COMMIT}}

# Auth -- generate real values locally with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse a value from this file, and never commit a real one.
# MFA_ENCRYPTION_KEY must be 32 raw bytes, hex-encoded (64 hex characters)
# -- it's an AES-256-GCM key, not a hash (see AuthConfig in config.ts).
JWT_SECRET={{GENERATE_LOCALLY_DO_NOT_COMMIT}}
MFA_ENCRYPTION_KEY={{GENERATE_LOCALLY_DO_NOT_COMMIT}}

# Email -- mailpit is config.ts's own local-dev default; only needed if
# you're running a local Mailpit instance (or Docker equivalent).
EMAIL_PROVIDER=mailpit
EMAIL_FROM_ADDRESS=noreply@ghs.local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# Geo-IP (ghs#234) -- entirely optional. Without a database file, every
# login attempt's country/region/city simply stays null (graceful
# degradation, not an error) -- the exact same behaviour as before this
# feature existed.
#
# GEOIP_DB_PATH: only needed to override config.ts's own default
# (apps/api/data/geoip/GeoLite2-City.mmdb, relative to cwd). The running
# app never contacts MaxMind itself -- this is a plain local file path,
# read once at startup.
#
# MAXMIND_LICENSE_KEY: NOT read by the app at all -- only used manually
# (or by the CI deploy job, as a separate GitHub Actions secret) to
# download the .mmdb file in the first place. Free account+key at
# https://www.maxmind.com/en/geolite2/signup. One-time local download,
# from apps/api (adjust the path if you set GEOIP_DB_PATH above --
# plain `tar -C dir -xzf` + find, not --wildcards, which GNU tar
# supports but macOS's bundled bsdtar silently doesn't):
#   curl -sL "https://download.maxmind.com/app/geoip_download?edition_id=GeoLite2-City&license_key=$MAXMIND_LICENSE_KEY&suffix=tar.gz" -o /tmp/geolite2.tar.gz
#   mkdir -p data/geoip /tmp/geolite2-extract && tar -xzf /tmp/geolite2.tar.gz -C /tmp/geolite2-extract
#   cp /tmp/geolite2-extract/*/GeoLite2-City.mmdb data/geoip/GeoLite2-City.mmdb
#   rm -rf /tmp/geolite2.tar.gz /tmp/geolite2-extract
# GEOIP_DB_PATH={{OPTIONAL_OVERRIDE}}
# MAXMIND_LICENSE_KEY={{YOUR_FREE_MAXMIND_LICENSE_KEY}}
